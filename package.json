{
  "name": "ai-study-assistant",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20.19.0"
  },
  "scripts": {
    "dev": "concurrently -k \"npm:dev:server\" \"npm:dev:client\"",
    "dev:client": "vite --host 0.0.0.0",
    "dev:server": "node --watch server/server.js",
    "build": "vite build",
    "start": "node server/server.js",
    "preview": "vite preview",
    "test": "node --test",
    "format": "prettier --write \"src/**/*.{js,jsx,css}\" \"server/**/*.js\" index.html package.json package-lock.json README.md",
    "format:check": "prettier --check \"src/**/*.{js,jsx,css}\" \"server/**/*.js\" index.html package.json package-lock.json README.md"
  },
  "dependencies": {
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "concurrently": "^9.1.2",
    "prettier": "^3.9.9",
    "vite": "^7.3.6"
  }
}
